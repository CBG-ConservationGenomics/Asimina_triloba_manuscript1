# image.generic.conf – default image settings for Circos

# Output directory and filename (no extension)
dir   = output
file  = circos

# Output formats
png   = yes
svg   = yes

# Overall radius of the plot
radius = 1500p

# Default background (can be overridden in background.white.conf)
#background = black

# Optional: anti-aliasing and compression tweaks
# (you can omit these if housekeeping.conf already handles them)
# anti_aliasing = yes
# pCri          = 0.0
